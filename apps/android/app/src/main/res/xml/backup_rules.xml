<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto Backup policy for API 26–30. API 31+ uses data_extraction_rules.xml, which draws
    the same line with a separate device-transfer case; keep the two in step.
-->
<full-backup-content>
    <!-- Keystore-bound ciphertext: a restored copy is undecryptable. -->
    <exclude domain="sharedpref" path="ring_key.xml" />
    <!-- oura.db, the summary cache and profile.json — health data stays on the device. -->
    <exclude domain="file" path="." />
</full-backup-content>
