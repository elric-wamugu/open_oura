<?xml version="1.0" encoding="utf-8"?>
<!-- updatePeriodMillis is deliberately 0: it has a 30-minute floor and fires unreliably.
     Updates are driven explicitly instead — after a summary refresh, and from a periodic
     WorkManager job. See WidgetUpdates.kt. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="70dp"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_activity_desc" />
