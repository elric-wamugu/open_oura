<?xml version="1.0" encoding="utf-8"?>
<!-- updatePeriodMillis is deliberately 0: it has a 30-minute floor and fires unreliably.
     Updates are driven explicitly instead — after a summary refresh, and from a periodic
     WorkManager job. See WidgetUpdates.kt. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_loading"
    android:previewLayout="@layout/preview_activity"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_activity_desc" />
