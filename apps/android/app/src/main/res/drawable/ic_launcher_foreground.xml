<?xml version="1.0" encoding="utf-8"?>
<!--
  open_oura mark: an open ring — the device, and the "open" in the name.

  Original artwork, deliberately NOT Oura's branding. This is an unofficial third-party
  client, so it must not carry the vendor's wordmark, and it must not ship an icon a user
  could mistake for the official app in their drawer.

  108dp adaptive canvas; the ring is r=26 about centre (54,54), well inside the 66dp safe
  zone, so no launcher mask can clip it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 300° arc, leaving a 60° gap at the top -->
    <path
        android:pathData="M70.71,34.08 A26,26 0 1 1 45.11,29.57"
        android:strokeColor="#2DD4BF"
        android:strokeWidth="7.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
</vector>
