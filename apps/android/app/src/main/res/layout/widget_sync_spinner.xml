<?xml version="1.0" encoding="utf-8"?>
<!-- The refresh button while a sync it started is running: the same icon in the same
     place, turning. Same 36 dp box and 18 dp glyph as the button in Widgets.kt, so nothing
     moves when one replaces the other. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="36dp"
    android:layout_height="36dp"
    android:contentDescription="@string/widget_syncing">
    <ProgressBar
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:indeterminateOnly="true"
        android:indeterminateDrawable="@drawable/widget_sync_spin"
        android:indeterminateTint="@color/widget_text_muted"
        android:indeterminateDuration="1100"
        android:interpolator="@android:anim/linear_interpolator" />
</FrameLayout>
