<?xml version="1.0" encoding="utf-8"?>
<!-- Static mock shown in the widget picker. Not the live widget — the picker cannot run
     Glance — so it just has to look like the real thing at a glance. Kept in step with
     Widgets.kt: brand colours, the headline on a primary-container pill. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@drawable/widget_pill"
        android:paddingHorizontal="12dp" android:paddingVertical="8dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Resting HR" android:textColor="@color/brand_on_primary_container"
            android:textSize="12sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="54 bpm" android:textColor="@color/brand_on_primary_container"
            android:textSize="28sp" android:textStyle="bold" />
    </LinearLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:text="11 below baseline 65"
        android:textColor="@color/brand_on_secondary_container" android:textSize="12sp" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="HRV  42 ms"
        android:textColor="@color/brand_on_secondary_container" android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
