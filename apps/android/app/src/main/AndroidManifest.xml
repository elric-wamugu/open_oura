<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        BLE, API 31+. neverForLocation is an assertion that we do not derive location from
        scan results; without it Android forces the scan to also hold ACCESS_FINE_LOCATION.
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!--
        The pre-31 equivalents. minSdk is 26, so these still matter: before Android 12 a BLE
        scan was treated as a location capability and genuinely required FINE_LOCATION.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />

    <!--
        A drain runs for minutes and must survive the screen going off, so it lives in a
        foreground service. On API 34 the `connectedDevice` type is mandatory — startForeground
        throws without it — and the type needs its own matching permission.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE"
        tools:targetApi="34" />
    <!-- API 33+. Without it the sync still runs, but its progress notification is hidden. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Health Connect. Write-only, and every type is one the ring actually measures — the
        export exists so other apps can read the ring's data, not so this one can read
        theirs. Health Connect is on-device storage, so this does not contradict the
        "nothing left the device" claim; whether anything syncs it onward is the user's
        business and their other apps'.
    -->
    <uses-permission android:name="android.permission.health.WRITE_SLEEP" />
    <uses-permission android:name="android.permission.health.WRITE_RESTING_HEART_RATE" />
    <uses-permission android:name="android.permission.health.WRITE_HEART_RATE_VARIABILITY" />
    <uses-permission android:name="android.permission.health.WRITE_OXYGEN_SATURATION" />
    <uses-permission android:name="android.permission.health.WRITE_STEPS" />
    <uses-permission android:name="android.permission.health.WRITE_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.WRITE_TOTAL_CALORIES_BURNED" />

    <!-- No BLE, no ring: this app has nothing to offer a device without it. -->
    <!-- The ring as a companion device (sync/RingCompanion.kt): linked, the app is left out
         of Doze and App Standby, may start its sync service from the background, and is
         woken when the ring comes back into range. Nothing here is used until it is linked. -->
    <uses-permission android:name="android.permission.REQUEST_COMPANION_RUN_IN_BACKGROUND" />
    <uses-permission android:name="android.permission.REQUEST_COMPANION_START_FOREGROUND_SERVICES_FROM_BACKGROUND" />
    <uses-permission android:name="android.permission.REQUEST_OBSERVE_COMPANION_DEVICE_PRESENCE" />
    <uses-feature android:name="android.software.companion_device_setup" android:required="false" />

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.OpenOura">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.OpenOura"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!--
            Health Connect requires a way to explain why the app wants health data, or it
            refuses the permission request outright. Two declarations because two eras:
            the intent filter below serves the standalone Health Connect app (Android 13),
            the activity-alias serves the platform one (Android 14+).
        -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".sync.RingPresenceService"
            android:enabled="@bool/companion_presence"
            tools:targetApi="33"
            android:exported="true"
            android:permission="android.permission.BIND_COMPANION_DEVICE_SERVICE">
            <intent-filter>
                <action android:name="android.companion.CompanionDeviceService" />
            </intent-filter>
        </service>

        <service
            android:name=".ble.RingSyncService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- ActivityWidgetReceiver keeps its name from the "Today" widget it replaced, so one
             already on a home screen becomes the stage ring instead of disappearing. -->
        <receiver
            android:name=".widget.ActivityWidgetReceiver"
            android:label="@string/widget_ring_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_ring" />
        </receiver>

        <receiver
            android:name=".widget.StepsWidgetReceiver"
            android:label="@string/widget_steps_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_steps" />
        </receiver>

        <receiver
            android:name=".widget.BatteryWidgetReceiver"
            android:label="@string/widget_battery_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_battery" />
        </receiver>
    </application>

</manifest>